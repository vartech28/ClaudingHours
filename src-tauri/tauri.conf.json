{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClaudingHours",
  "version": "1.2.7",
  "identifier": "com.claudinghours.app",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "ClaudingHours",
        "width": 400,
        "height": 560,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "overlay",
        "title": "ClaudingHours Overlay",
        "url": "overlay.html",
        "width": 900,
        "height": 500,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
